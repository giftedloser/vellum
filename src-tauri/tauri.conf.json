{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.1.0",
  "identifier": "com.giftedloser.vellum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vellum",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: asset: http: https:; base-uri *; object-src 'none'; img-src 'self' data: blob: asset: file: http: https:; media-src 'self' data: blob: asset: file: http: https:; font-src 'self' data: blob: asset: http: https:; style-src 'self' 'unsafe-inline' data: blob: asset: http: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: http: https:; connect-src 'self' data: blob: asset: http: https: ws: wss:; worker-src 'self' data: blob:; frame-src 'self' data: blob: asset: file: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Vellum Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": ["html", "htm"],
        "name": "Vellum HTML Document",
        "description": "HTML document",
        "mimeType": "text/html",
        "role": "Viewer"
      }
    ]
  }
}
