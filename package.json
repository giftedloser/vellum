{
  "name": "vellum",
  "private": true,
  "version": "1.0.0",
  "description": "A focused desktop workspace for Markdown, HTML, text files, and persistent notes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giftedloser/vellum.git"
  },
  "homepage": "https://github.com/giftedloser/vellum#readme",
